#: common/partitioning.cpp
msgid "The disk has no partition table. Create one first."
msgstr "Die Festplatte hat keine Partitionstabelle. Erstellen Sie zuerst eine."

#: common/partitioning.cpp
msgid "A disk with an MBR partition table holds at most four partitions."
msgstr "Eine Festplatte mit MBR-Partitionstabelle kann höchstens vier Partitionen enthalten."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{mount}” is not a mount point the system can use."
msgstr "„{mount}“ ist kein Einhängepunkt, den das System verwenden kann."

#: common/partitioning.cpp
#, python-brace-format
msgid "Two partitions are given “{mount}”."
msgstr "Zwei Partitionen haben den Einhängepunkt „{mount}“."

#: common/partitioning.cpp
msgid "Only a disk with a GPT partition table needs a BIOS boot partition."
msgstr "Nur eine Festplatte mit GPT-Partitionstabelle benötigt eine BIOS-Boot-Partition."

#: common/partitioning.cpp
msgid "Only a new partition, or one made for it, can be the BIOS boot partition."
msgstr "Nur eine neue Partition oder eine eigens dafür angelegte kann die BIOS-Boot-Partition sein."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” must be formatted."
msgstr "Die Partition für „{mount}“ muss formatiert werden."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{type}” cannot be used for “{mount}”."
msgstr "„{type}“ kann nicht für „{mount}“ verwendet werden."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds no file system; format it to use it there."
msgstr "Die Partition für „{mount}“ enthält kein Dateisystem. Formatieren Sie sie, um sie dafür zu verwenden."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds “{type}”; format it to use it there."
msgstr "Die Partition für „{mount}“ enthält „{type}“. Formatieren Sie sie, um sie dafür zu verwenden."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose a partition for the system: give one the mount point “{mount}”."
msgstr "Wählen Sie eine Partition für das System: Geben Sie einer den Einhängepunkt „{mount}“."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” needs at least {size} GB."
msgstr "Die Partition für „{mount}“ benötigt mindestens {size} GB."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose an EFI system partition: give one the mount point “{mount}”."
msgstr "Wählen Sie eine EFI-Systempartition: Geben Sie einer den Einhängepunkt „{mount}“."

#: common/partitioning.cpp
msgid "The EFI system partition needs at least 32 MB."
msgstr "Die EFI-Systempartition benötigt mindestens 32 MB."

#: common/partitioning.cpp
msgid "Add a 1 MB partition used as BIOS boot, for the boot loader."
msgstr "Fügen Sie für den Bootloader eine 1-MB-Partition vom Typ BIOS-Boot hinzu."

#: src/backend.cpp
msgid "The installer service stopped unexpectedly."
msgstr "Der Installationsdienst wurde unerwartet beendet."

#: src/backend.cpp
msgid "The system bus cannot be reached."
msgstr "Der Systembus ist nicht erreichbar."

#: src/backend.cpp
msgid "The disks cannot be listed."
msgstr "Die Festplatten können nicht aufgelistet werden."

#: src/backend.cpp
msgid "The file systems cannot be listed."
msgstr "Die Dateisysteme können nicht aufgelistet werden."

#: src/backend.cpp
msgid "The partitions cannot be read."
msgstr "Die Partitionen können nicht gelesen werden."

#: src/installerwindow.cpp data/cutefish-installer.desktop
#: data/cutefish-installer-autostart.desktop
msgid "Install Cutefish"
msgstr "Cutefish installieren"

#: src/installerwindow.cpp
msgid "Back"
msgstr "Zurück"

#: src/installerwindow.cpp
msgid "Continue"
msgstr "Weiter"

#: src/installerwindow.cpp
msgid "Try Cutefish"
msgstr "Cutefish ausprobieren"

#: src/installerwindow.cpp
msgid "Next"
msgstr "Weiter"

#: src/installerwindow.cpp
msgid "Install"
msgstr "Installieren"

#: src/installerwindow.cpp
msgid "Erase Disk and Install"
msgstr "Festplatte löschen und installieren"

#. TRANSLATORS: After a successful installation: go on using the live system instead of restarting.
#: src/installerwindow.cpp
msgid "Keep Trying"
msgstr "Weiter ausprobieren"

#: src/installerwindow.cpp
msgid "Close"
msgstr "Schließen"

#: src/installerwindow.cpp
msgid "Restart Now"
msgstr "Jetzt neu starten"

#: src/installerwindow.cpp
msgid "Try Again"
msgstr "Erneut versuchen"

#: src/pages.cpp
msgid "Choose Your Language"
msgstr "Sprache wählen"

#: src/pages.cpp
msgid "The installer and the installed system use this language."
msgstr "Das Installationsprogramm und das installierte System verwenden diese Sprache."

#: src/pages.cpp
msgid "Welcome to Cutefish"
msgstr "Willkommen bei Cutefish"

#: src/pages.cpp
msgid "Try Cutefish without changing your computer, or install it now."
msgstr "Probieren Sie Cutefish aus, ohne Ihren Computer zu verändern, oder installieren Sie es jetzt."

#: src/pages.cpp
msgid "Choose a Disk"
msgstr "Festplatte wählen"

#: src/pages.cpp
msgid "Cutefish uses the whole disk. Everything on it will be erased."
msgstr "Cutefish belegt die gesamte Festplatte. Alle Daten darauf werden gelöscht."

#: src/pages.cpp
msgid "Partition manually"
msgstr "Manuell partitionieren"

#: src/pages.cpp
msgid "Choose the partitions on the next page."
msgstr "Wählen Sie die Partitionen auf der nächsten Seite."

#. TRANSLATORS: Beside a disk; {size} is a size such as "12.0 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Too small, needs {size}"
msgstr "Zu klein, benötigt {size}"

#: src/pages.cpp
msgid "No disk was found to install on."
msgstr "Es wurde keine Festplatte zum Installieren gefunden."

#: src/pages.cpp
#, python-brace-format
msgid "The disks cannot be listed: {error}"
msgstr "Die Festplatten können nicht aufgelistet werden: {error}"

#: src/pages.cpp
msgid "Create Your Account"
msgstr "Konto erstellen"

#: src/pages.cpp
msgid "This account can change settings and install software."
msgstr "Dieses Konto kann Einstellungen ändern und Software installieren."

#: src/pages.cpp
msgid "Full name"
msgstr "Vollständiger Name"

#: src/pages.cpp
msgid "User name"
msgstr "Benutzername"

#: src/pages.cpp
msgid "Computer name"
msgstr "Computername"

#: src/pages.cpp
msgid "Password"
msgstr "Passwort"

#: src/pages.cpp
msgid "Confirm password"
msgstr "Passwort bestätigen"

#. TRANSLATORS: In an empty field that must be filled in.
#: src/pages.cpp
msgid "Required"
msgstr "Erforderlich"

#: src/pages.cpp
msgid "A user name starts with a lower-case letter and uses only a–z, 0–9, “-” and “_”."
msgstr "Ein Benutzername beginnt mit einem Kleinbuchstaben und enthält nur a–z, 0–9, „-“ und „_“."

#: src/pages.cpp
#, python-brace-format
msgid "“{name}” is taken by the system. Choose another user name."
msgstr "„{name}“ wird vom System verwendet. Wählen Sie einen anderen Benutzernamen."

#: src/pages.cpp
msgid "A computer name uses only letters, digits and hyphens, and does not start or end with a hyphen."
msgstr "Ein Computername enthält nur Buchstaben, Ziffern und Bindestriche und beginnt und endet nicht mit einem Bindestrich."

#: src/pages.cpp
msgid "The passwords do not match."
msgstr "Die Passwörter stimmen nicht überein."

#: src/pages.cpp
msgid "Choose Your Time Zone"
msgstr "Zeitzone wählen"

#: src/pages.cpp
msgid "The clock follows the time zone. You can change it later in Settings."
msgstr "Die Uhr richtet sich nach der Zeitzone. Sie können sie später in den Einstellungen ändern."

#: src/pages.cpp
msgid "Search for a city or country"
msgstr "Stadt oder Land suchen"

#: src/pages.cpp
msgid "Ready to Install"
msgstr "Bereit zur Installation"

#: src/pages.cpp
msgid "Check your choices. Go back to change any of them."
msgstr "Prüfen Sie Ihre Auswahl. Gehen Sie zurück, um etwas zu ändern."

#: src/pages.cpp
msgid "Disk"
msgstr "Festplatte"

#: src/pages.cpp
msgid "Time zone"
msgstr "Zeitzone"

#. TRANSLATORS: {disk} is a disk's name and size, such as "Samsung SSD (512.1 GB)".
#: src/pages.cpp
#, python-brace-format
msgid "Partitioned manually, {disk}"
msgstr "Manuell partitioniert, {disk}"

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {disk} will be erased. This cannot be undone."
msgstr "Alle Daten auf {disk} werden gelöscht. Dies kann nicht rückgängig gemacht werden."

#: src/pages.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted. This cannot be undone."
msgstr "Alle Partitionen auf {disk} werden gelöscht. Dies kann nicht rückgängig gemacht werden."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {partitions} will be erased. This cannot be undone."
msgstr "Alle Daten auf {partitions} werden gelöscht. Dies kann nicht rückgängig gemacht werden."

#: src/pages.cpp
msgid "No existing partition is erased."
msgstr "Keine vorhandene Partition wird gelöscht."

#: src/pages.cpp
msgid "Installing Cutefish"
msgstr "Cutefish wird installiert"

#: src/pages.cpp
msgid "Keep the computer on until the installation is complete."
msgstr "Lassen Sie den Computer eingeschaltet, bis die Installation abgeschlossen ist."

#: src/pages.cpp
msgid "Preparing the disk…"
msgstr "Festplatte wird vorbereitet …"

#: src/pages.cpp
msgid "Copying the system…"
msgstr "System wird kopiert …"

#: src/pages.cpp
msgid "Setting up your account and settings…"
msgstr "Konto und Einstellungen werden eingerichtet …"

#: src/pages.cpp
msgid "Installing the boot loader…"
msgstr "Bootloader wird installiert …"

#: src/pages.cpp
msgid "Finishing…"
msgstr "Wird abgeschlossen …"

#: src/pages.cpp
msgid "Cutefish Is Installed"
msgstr "Cutefish ist installiert"

#: src/pages.cpp
msgid "Restart the computer and remove the installation medium to start using Cutefish."
msgstr "Starten Sie den Computer neu und entfernen Sie das Installationsmedium, um Cutefish zu verwenden."

#: src/pages.cpp
msgid "The Installation Failed"
msgstr "Die Installation ist fehlgeschlagen"

#: src/pages.cpp
#, python-brace-format
msgid "Cutefish could not be installed. The details are in {path}."
msgstr "Cutefish konnte nicht installiert werden. Die Details stehen in {path}."

#. TRANSLATORS: What a partition is used for: nothing.
#: src/partitionpage.cpp
msgid "Not used"
msgstr "Nicht verwendet"

#. TRANSLATORS: What a partition is used for; {mount} is "/".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (system)"
msgstr "{mount} (System)"

#. TRANSLATORS: What a partition is used for; {mount} is "/boot/efi".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (EFI system)"
msgstr "{mount} (EFI-System)"

#. TRANSLATORS: What a partition is used for: swap space.
#: src/partitionpage.cpp
msgid "Swap"
msgstr "Swap"

#. TRANSLATORS: What a partition is used for: the boot loader on a computer without UEFI.
#: src/partitionpage.cpp
msgid "BIOS boot"
msgstr "BIOS-Boot"

#. TRANSLATORS: Marks a partition that exists and will be formatted.
#: src/partitionpage.cpp
msgid "Format"
msgstr "Wird formatiert"

#: src/partitionpage.cpp
msgid "Free space"
msgstr "Freier Speicher"

#: src/partitionpage.cpp
msgid "New partition"
msgstr "Neue Partition"

#: src/partitionpage.cpp
msgid "Size"
msgstr "Größe"

#: src/partitionpage.cpp
msgid "Use as"
msgstr "Verwenden als"

#: src/partitionpage.cpp
msgid "File system"
msgstr "Dateisystem"

#: src/partitionpage.cpp
msgid "Format this partition"
msgstr "Diese Partition formatieren"

#: src/partitionpage.cpp
msgid "Cancel"
msgstr "Abbrechen"

#: src/partitionpage.cpp
msgid "Add"
msgstr "Hinzufügen"

#: src/partitionpage.cpp
msgid "Save"
msgstr "Speichern"

#: src/partitionpage.cpp
msgid "Partition the Disk"
msgstr "Festplatte partitionieren"

#: src/partitionpage.cpp
msgid "New Partition Table"
msgstr "Neue Partitionstabelle"

#: src/partitionpage.cpp
msgid "Add…"
msgstr "Hinzufügen …"

#: src/partitionpage.cpp
msgid "Edit…"
msgstr "Bearbeiten …"

#: src/partitionpage.cpp
msgid "Delete"
msgstr "Löschen"

#. TRANSLATORS: "Partition" is the header of the column of partition names.
#: src/partitionpage.cpp
msgid "Partition"
msgstr "Partition"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Nothing changes on {disk} until you install."
msgstr "Bis zur Installation wird auf {disk} nichts verändert."

#: src/partitionpage.cpp
#, python-brace-format
msgid "The partitions cannot be read: {error}"
msgstr "Die Partitionen können nicht gelesen werden: {error}"

#: src/partitionpage.cpp
msgid "Create a new partition table?"
msgstr "Neue Partitionstabelle erstellen?"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted when Cutefish is installed."
msgstr "Bei der Installation von Cutefish werden alle Partitionen auf {disk} gelöscht."

#: src/partitionpage.cpp
msgid "Add Partition"
msgstr "Partition hinzufügen"

#: src/partitionpage.cpp
msgid "New Partition"
msgstr "Neue Partition"

#: data/cutefish-installer.desktop
msgid "Install Cutefish on this computer"
msgstr "Cutefish auf diesem Computer installieren"

#: data/cutefish-installer.desktop
msgid "Installer;Install;Setup;Disk;"
msgstr "Installationsprogramm;Installer;Installieren;Einrichtung;Setup;Festplatte;"
