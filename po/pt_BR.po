#: common/partitioning.cpp
msgid "The disk has no partition table. Create one first."
msgstr "O disco não tem tabela de partições. Crie uma primeiro."

#: common/partitioning.cpp
msgid "A disk with an MBR partition table holds at most four partitions."
msgstr "Um disco com tabela de partições MBR comporta no máximo quatro partições."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{mount}” is not a mount point the system can use."
msgstr "“{mount}” não é um ponto de montagem que o sistema possa usar."

#: common/partitioning.cpp
#, python-brace-format
msgid "Two partitions are given “{mount}”."
msgstr "Duas partições receberam “{mount}”."

#: common/partitioning.cpp
msgid "Only a disk with a GPT partition table needs a BIOS boot partition."
msgstr "Somente um disco com tabela de partições GPT precisa de uma partição de inicialização BIOS."

#: common/partitioning.cpp
msgid "Only a new partition, or one made for it, can be the BIOS boot partition."
msgstr "Somente uma partição nova, ou uma criada para isso, pode ser a partição de inicialização BIOS."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” must be formatted."
msgstr "A partição de “{mount}” precisa ser formatada."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{type}” cannot be used for “{mount}”."
msgstr "“{type}” não pode ser usado em “{mount}”."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds no file system; format it to use it there."
msgstr "A partição de “{mount}” não contém sistema de arquivos; formate-a para usá-la ali."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds “{type}”; format it to use it there."
msgstr "A partição de “{mount}” contém “{type}”; formate-a para usá-la ali."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose a partition for the system: give one the mount point “{mount}”."
msgstr "Escolha uma partição para o sistema: atribua a uma delas o ponto de montagem “{mount}”."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” needs at least {size} GB."
msgstr "A partição de “{mount}” precisa de pelo menos {size} GB."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose an EFI system partition: give one the mount point “{mount}”."
msgstr "Escolha uma partição de sistema EFI: atribua a uma delas o ponto de montagem “{mount}”."

#: common/partitioning.cpp
msgid "The EFI system partition needs at least 32 MB."
msgstr "A partição de sistema EFI precisa de pelo menos 32 MB."

#: common/partitioning.cpp
msgid "Add a 1 MB partition used as BIOS boot, for the boot loader."
msgstr "Adicione uma partição de 1 MB usada como inicialização BIOS, para o carregador de inicialização."

#: src/backend.cpp
msgid "The installer service stopped unexpectedly."
msgstr "O serviço do instalador parou inesperadamente."

#: src/backend.cpp
msgid "The system bus cannot be reached."
msgstr "Não é possível acessar o barramento do sistema."

#: src/backend.cpp
msgid "The disks cannot be listed."
msgstr "Não é possível listar os discos."

#: src/backend.cpp
msgid "The file systems cannot be listed."
msgstr "Não é possível listar os sistemas de arquivos."

#: src/backend.cpp
msgid "The partitions cannot be read."
msgstr "Não é possível ler as partições."

#: src/installerwindow.cpp data/cutefish-installer.desktop
#: data/cutefish-installer-autostart.desktop
msgid "Install Cutefish"
msgstr "Instalar o Cutefish"

#: src/installerwindow.cpp
msgid "Continue"
msgstr "Continuar"

#: src/installerwindow.cpp
msgid "Back"
msgstr "Voltar"

#: src/installerwindow.cpp
msgid "Try Cutefish"
msgstr "Experimentar o Cutefish"

#. TRANSLATORS: A button: choose the partitions by hand instead of erasing the disk.
#: src/installerwindow.cpp
msgid "Partition Manually"
msgstr "Particionar manualmente"

#: src/installerwindow.cpp
msgid "Install"
msgstr "Instalar"

#: src/installerwindow.cpp
msgid "Erase Disk and Install"
msgstr "Apagar o disco e instalar"

#. TRANSLATORS: After a successful installation: go on using the live system instead of restarting.
#: src/installerwindow.cpp
msgid "Keep Trying"
msgstr "Continuar experimentando"

#: src/installerwindow.cpp
msgid "Close"
msgstr "Fechar"

#: src/installerwindow.cpp
msgid "Restart Now"
msgstr "Reiniciar agora"

#: src/installerwindow.cpp
msgid "Try Again"
msgstr "Tentar novamente"

#: src/pages.cpp
msgid "Choose Your Language"
msgstr "Escolha seu idioma"

#: src/pages.cpp
msgid "The installer and the installed system use this language."
msgstr "O instalador e o sistema instalado usam este idioma."

#: src/pages.cpp
msgid "Welcome to Cutefish"
msgstr "Bem-vindo ao Cutefish"

#: src/pages.cpp
msgid "Try Cutefish without changing your computer, or install it now."
msgstr "Experimente o Cutefish sem alterar seu computador ou instale-o agora."

#: src/pages.cpp
msgid "Choose a Disk"
msgstr "Escolha um disco"

#: src/pages.cpp
msgid "Cutefish uses the whole disk. Everything on it will be erased."
msgstr "O Cutefish usa o disco inteiro. Tudo o que estiver nele será apagado."

#. TRANSLATORS: Beside a disk; {size} is a size such as "12.0 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Too small, needs {size}"
msgstr "Pequeno demais, precisa de {size}"

#: src/pages.cpp
msgid "No disk was found to install on."
msgstr "Nenhum disco foi encontrado para a instalação."

#: src/pages.cpp
#, python-brace-format
msgid "The disks cannot be listed: {error}"
msgstr "Não é possível listar os discos: {error}"

#: src/pages.cpp
msgid "Create Your Account"
msgstr "Crie sua conta"

#: src/pages.cpp
msgid "This account can change settings and install software."
msgstr "Esta conta pode alterar configurações e instalar software."

#: src/pages.cpp
msgid "Full name"
msgstr "Nome completo"

#: src/pages.cpp
msgid "User name"
msgstr "Nome de usuário"

#: src/pages.cpp
msgid "Computer name"
msgstr "Nome do computador"

#: src/pages.cpp
msgid "Password"
msgstr "Senha"

#. TRANSLATORS: In the empty field where the password is typed a second time.
#: src/pages.cpp
msgid "Verify"
msgstr "Confirmar"

#. TRANSLATORS: In an empty field that must be filled in.
#: src/pages.cpp
msgid "Required"
msgstr "Obrigatório"

#: src/pages.cpp
msgid "A user name starts with a lower-case letter and uses only a–z, 0–9, “-” and “_”."
msgstr "Um nome de usuário começa com uma letra minúscula e usa somente a–z, 0–9, “-” e “_”."

#: src/pages.cpp
#, python-brace-format
msgid "“{name}” is taken by the system. Choose another user name."
msgstr "“{name}” é usado pelo sistema. Escolha outro nome de usuário."

#: src/pages.cpp
msgid "A computer name uses only letters, digits and hyphens, and does not start or end with a hyphen."
msgstr "Um nome de computador usa somente letras, algarismos e hífens, e não começa nem termina com hífen."

#: src/pages.cpp
msgid "The passwords do not match."
msgstr "As senhas não coincidem."

#: src/pages.cpp
msgid "Choose Your Time Zone"
msgstr "Escolha seu fuso horário"

#: src/pages.cpp
msgid "The clock follows the time zone. You can change it later in Settings."
msgstr "O relógio segue o fuso horário. Você pode alterá-lo depois em Configurações."

#: src/pages.cpp
msgid "Search for a city or country"
msgstr "Pesquisar cidade ou país"

#. TRANSLATORS: Where the cities found would be listed, when the search finds none.
#: src/pages.cpp
msgid "No Results"
msgstr "Nenhum resultado"

#: src/pages.cpp
msgid "Ready to Install"
msgstr "Pronto para instalar"

#: src/pages.cpp
msgid "Check your choices. Go back to change any of them."
msgstr "Confira suas escolhas. Volte para alterar qualquer uma delas."

#. TRANSLATORS: Under a disk's name; {disk} is its size, such as "512.1 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Partitioned manually, {disk}"
msgstr "Particionado manualmente, {disk}"

#: src/pages.cpp
msgid "No existing partition is erased."
msgstr "Nenhuma partição existente será apagada."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {disk} will be erased. This cannot be undone."
msgstr "Tudo o que estiver em {disk} será apagado. Não é possível desfazer esta ação."

#: src/pages.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted. This cannot be undone."
msgstr "Todas as partições de {disk} serão excluídas. Não é possível desfazer esta ação."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {partitions} will be erased. This cannot be undone."
msgstr "Tudo o que estiver em {partitions} será apagado. Não é possível desfazer esta ação."

#: src/pages.cpp
msgid "Installing Cutefish"
msgstr "Instalando o Cutefish"

#: src/pages.cpp
msgid "Keep the computer on until the installation is complete."
msgstr "Mantenha o computador ligado até a instalação terminar."

#: src/pages.cpp
msgid "Preparing the disk…"
msgstr "Preparando o disco…"

#: src/pages.cpp
msgid "Copying the system…"
msgstr "Copiando o sistema…"

#: src/pages.cpp
msgid "Setting up your account and settings…"
msgstr "Configurando sua conta e suas configurações…"

#: src/pages.cpp
msgid "Installing the boot loader…"
msgstr "Instalando o carregador de inicialização…"

#: src/pages.cpp
msgid "Finishing…"
msgstr "Finalizando…"

#: src/pages.cpp
msgid "Cutefish Is Installed"
msgstr "O Cutefish está instalado"

#: src/pages.cpp
msgid "Restart the computer and remove the installation medium to start using Cutefish."
msgstr "Reinicie o computador e remova a mídia de instalação para começar a usar o Cutefish."

#: src/pages.cpp
msgid "The Installation Failed"
msgstr "A instalação falhou"

#: src/pages.cpp
#, python-brace-format
msgid "Cutefish could not be installed. The details are in {path}."
msgstr "Não foi possível instalar o Cutefish. Os detalhes estão em {path}."

#. TRANSLATORS: What a partition is used for: nothing.
#: src/partitionpage.cpp
msgid "Not used"
msgstr "Não usada"

#. TRANSLATORS: What a partition is used for; {mount} is "/".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (system)"
msgstr "{mount} (sistema)"

#. TRANSLATORS: What a partition is used for; {mount} is "/boot/efi".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (EFI system)"
msgstr "{mount} (sistema EFI)"

#. TRANSLATORS: What a partition is used for: swap space.
#: src/partitionpage.cpp
msgid "Swap"
msgstr "Swap"

#. TRANSLATORS: What a partition is used for: the boot loader on a computer without UEFI.
#: src/partitionpage.cpp
msgid "BIOS boot"
msgstr "Inicialização BIOS"

#. TRANSLATORS: Marks a partition that exists and will be formatted.
#: src/partitionpage.cpp
msgid "Format"
msgstr "Formatar"

#: src/partitionpage.cpp
msgid "Free space"
msgstr "Espaço livre"

#: src/partitionpage.cpp
msgid "New partition"
msgstr "Nova partição"

#: src/partitionpage.cpp
msgid "Size"
msgstr "Tamanho"

#: src/partitionpage.cpp
msgid "Use as"
msgstr "Usar como"

#: src/partitionpage.cpp
msgid "File system"
msgstr "Sistema de arquivos"

#: src/partitionpage.cpp
msgid "Format this partition"
msgstr "Formatar esta partição"

#: src/partitionpage.cpp
msgid "Cancel"
msgstr "Cancelar"

#: src/partitionpage.cpp
msgid "Add"
msgstr "Adicionar"

#: src/partitionpage.cpp
msgid "Save"
msgstr "Salvar"

#: src/partitionpage.cpp
msgid "Partition the Disk"
msgstr "Particionar o disco"

#: src/partitionpage.cpp
msgid "New Partition Table"
msgstr "Nova tabela de partições"

#: src/partitionpage.cpp
msgid "Add…"
msgstr "Adicionar…"

#: src/partitionpage.cpp
msgid "Edit…"
msgstr "Editar…"

#: src/partitionpage.cpp
msgid "Delete"
msgstr "Excluir"

#. TRANSLATORS: "Partition" is the header of the column of partition names.
#: src/partitionpage.cpp
msgid "Partition"
msgstr "Partição"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Nothing changes on {disk} until you install."
msgstr "Nada muda em {disk} até você instalar."

#: src/partitionpage.cpp
#, python-brace-format
msgid "The partitions cannot be read: {error}"
msgstr "Não é possível ler as partições: {error}"

#: src/partitionpage.cpp
msgid "Create a new partition table?"
msgstr "Criar uma nova tabela de partições?"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted when Cutefish is installed."
msgstr "Todas as partições de {disk} serão excluídas quando o Cutefish for instalado."

#: src/partitionpage.cpp
msgid "Add Partition"
msgstr "Adicionar partição"

#: src/partitionpage.cpp
msgid "New Partition"
msgstr "Nova partição"

#: data/cutefish-installer.desktop
msgid "Install Cutefish on this computer"
msgstr "Instale o Cutefish neste computador"

#: data/cutefish-installer.desktop
msgid "Installer;Install;Setup;Disk;"
msgstr "Instalador;Instalar;Instalação;Configuração;Disco;Installer;Install;"
