#: common/partitioning.cpp
msgid "The disk has no partition table. Create one first."
msgstr "Cakera tiada jadual partisyen. Cipta satu dahulu."

#: common/partitioning.cpp
msgid "A disk with an MBR partition table holds at most four partitions."
msgstr "Cakera dengan jadual partisyen MBR memuatkan paling banyak empat partisyen."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{mount}” is not a mount point the system can use."
msgstr "“{mount}” bukan titik lekap yang boleh digunakan oleh sistem."

#: common/partitioning.cpp
#, python-brace-format
msgid "Two partitions are given “{mount}”."
msgstr "Dua partisyen diberi “{mount}”."

#: common/partitioning.cpp
msgid "Only a disk with a GPT partition table needs a BIOS boot partition."
msgstr "Hanya cakera dengan jadual partisyen GPT memerlukan partisyen but BIOS."

#: common/partitioning.cpp
msgid "Only a new partition, or one made for it, can be the BIOS boot partition."
msgstr "Hanya partisyen baharu, atau yang dibuat untuknya, boleh menjadi partisyen but BIOS."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” must be formatted."
msgstr "Partisyen untuk “{mount}” mesti diformat."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{type}” cannot be used for “{mount}”."
msgstr "“{type}” tidak boleh digunakan untuk “{mount}”."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds no file system; format it to use it there."
msgstr "Partisyen untuk “{mount}” tiada sistem fail; formatkannya untuk menggunakannya di situ."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds “{type}”; format it to use it there."
msgstr "Partisyen untuk “{mount}” mengandungi “{type}”; formatkannya untuk menggunakannya di situ."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose a partition for the system: give one the mount point “{mount}”."
msgstr "Pilih partisyen untuk sistem: beri satu partisyen titik lekap “{mount}”."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” needs at least {size} GB."
msgstr "Partisyen untuk “{mount}” memerlukan sekurang-kurangnya {size} GB."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose an EFI system partition: give one the mount point “{mount}”."
msgstr "Pilih partisyen sistem EFI: beri satu partisyen titik lekap “{mount}”."

#: common/partitioning.cpp
msgid "The EFI system partition needs at least 32 MB."
msgstr "Partisyen sistem EFI memerlukan sekurang-kurangnya 32 MB."

#: common/partitioning.cpp
msgid "Add a 1 MB partition used as BIOS boot, for the boot loader."
msgstr "Tambah partisyen 1 MB yang digunakan sebagai but BIOS, untuk pemuat but."

#: src/backend.cpp
msgid "The installer service stopped unexpectedly."
msgstr "Perkhidmatan pemasang berhenti secara tidak dijangka."

#: src/backend.cpp
msgid "The system bus cannot be reached."
msgstr "Bas sistem tidak dapat dicapai."

#: src/backend.cpp
msgid "The disks cannot be listed."
msgstr "Cakera tidak dapat disenaraikan."

#: src/backend.cpp
msgid "The file systems cannot be listed."
msgstr "Sistem fail tidak dapat disenaraikan."

#: src/backend.cpp
msgid "The partitions cannot be read."
msgstr "Partisyen tidak dapat dibaca."

#: src/installerwindow.cpp data/cutefish-installer.desktop
#: data/cutefish-installer-autostart.desktop
msgid "Install Cutefish"
msgstr "Pasang Cutefish"

#: src/installerwindow.cpp
msgid "Continue"
msgstr "Teruskan"

#: src/installerwindow.cpp
msgid "Back"
msgstr "Kembali"

#: src/installerwindow.cpp
msgid "Try Cutefish"
msgstr "Cuba Cutefish"

#. TRANSLATORS: A button: choose the partitions by hand instead of erasing the disk.
#: src/installerwindow.cpp
msgid "Partition Manually"
msgstr "Partisyen Secara Manual"

#: src/installerwindow.cpp
msgid "Install"
msgstr "Pasang"

#: src/installerwindow.cpp
msgid "Erase Disk and Install"
msgstr "Padam Cakera dan Pasang"

#. TRANSLATORS: After a successful installation: go on using the live system instead of restarting.
#: src/installerwindow.cpp
msgid "Keep Trying"
msgstr "Terus Mencuba"

#: src/installerwindow.cpp
msgid "Close"
msgstr "Tutup"

#: src/installerwindow.cpp
msgid "Restart Now"
msgstr "Mula Semula Sekarang"

#: src/installerwindow.cpp
msgid "Try Again"
msgstr "Cuba Lagi"

#: src/pages.cpp
msgid "Choose Your Language"
msgstr "Pilih Bahasa Anda"

#: src/pages.cpp
msgid "The installer and the installed system use this language."
msgstr "Pemasang dan sistem yang dipasang menggunakan bahasa ini."

#: src/pages.cpp
msgid "Welcome to Cutefish"
msgstr "Selamat Datang ke Cutefish"

#: src/pages.cpp
msgid "Try Cutefish without changing your computer, or install it now."
msgstr "Cuba Cutefish tanpa mengubah komputer anda, atau pasangkannya sekarang."

#: src/pages.cpp
msgid "Choose a Disk"
msgstr "Pilih Cakera"

#: src/pages.cpp
msgid "Cutefish uses the whole disk. Everything on it will be erased."
msgstr "Cutefish menggunakan seluruh cakera. Semua kandungannya akan dipadam."

#. TRANSLATORS: Beside a disk; {size} is a size such as "12.0 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Too small, needs {size}"
msgstr "Terlalu kecil, perlu {size}"

#: src/pages.cpp
msgid "No disk was found to install on."
msgstr "Tiada cakera ditemui untuk dipasang."

#: src/pages.cpp
#, python-brace-format
msgid "The disks cannot be listed: {error}"
msgstr "Cakera tidak dapat disenaraikan: {error}"

#: src/pages.cpp
msgid "Create Your Account"
msgstr "Cipta Akaun Anda"

#: src/pages.cpp
msgid "This account can change settings and install software."
msgstr "Akaun ini boleh mengubah tetapan dan memasang perisian."

#: src/pages.cpp
msgid "Full name"
msgstr "Nama penuh"

#: src/pages.cpp
msgid "User name"
msgstr "Nama pengguna"

#: src/pages.cpp
msgid "Computer name"
msgstr "Nama komputer"

#: src/pages.cpp
msgid "Password"
msgstr "Kata laluan"

#. TRANSLATORS: In the empty field where the password is typed a second time.
#: src/pages.cpp
msgid "Verify"
msgstr "Sahkan"

#. TRANSLATORS: In an empty field that must be filled in.
#: src/pages.cpp
msgid "Required"
msgstr "Wajib"

#: src/pages.cpp
msgid "A user name starts with a lower-case letter and uses only a–z, 0–9, “-” and “_”."
msgstr "Nama pengguna bermula dengan huruf kecil dan hanya menggunakan a–z, 0–9, “-” dan “_”."

#: src/pages.cpp
#, python-brace-format
msgid "“{name}” is taken by the system. Choose another user name."
msgstr "“{name}” telah digunakan oleh sistem. Pilih nama pengguna lain."

#: src/pages.cpp
msgid "A computer name uses only letters, digits and hyphens, and does not start or end with a hyphen."
msgstr "Nama komputer hanya menggunakan huruf, digit dan tanda sempang, dan tidak bermula atau berakhir dengan tanda sempang."

#: src/pages.cpp
msgid "The passwords do not match."
msgstr "Kata laluan tidak sepadan."

#: src/pages.cpp
msgid "Choose Your Time Zone"
msgstr "Pilih Zon Waktu Anda"

#: src/pages.cpp
msgid "The clock follows the time zone. You can change it later in Settings."
msgstr "Jam mengikut zon waktu. Anda boleh mengubahnya kemudian dalam Tetapan."

#: src/pages.cpp
msgid "Search for a city or country"
msgstr "Cari bandar atau negara"

#. TRANSLATORS: Where the cities found would be listed, when the search finds none.
#: src/pages.cpp
msgid "No Results"
msgstr "Tiada Hasil"

#: src/pages.cpp
msgid "Ready to Install"
msgstr "Sedia untuk Dipasang"

#: src/pages.cpp
msgid "Check your choices. Go back to change any of them."
msgstr "Semak pilihan anda. Kembali untuk mengubah mana-mana pilihan."

#. TRANSLATORS: Under a disk's name; {disk} is its size, such as "512.1 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Partitioned manually, {disk}"
msgstr "Dipartisyen secara manual, {disk}"

#: src/pages.cpp
msgid "No existing partition is erased."
msgstr "Tiada partisyen sedia ada yang dipadam."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {disk} will be erased. This cannot be undone."
msgstr "Semua kandungan pada {disk} akan dipadam. Tindakan ini tidak boleh dibuat asal."

#: src/pages.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted. This cannot be undone."
msgstr "Setiap partisyen pada {disk} akan dipadam. Tindakan ini tidak boleh dibuat asal."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {partitions} will be erased. This cannot be undone."
msgstr "Semua kandungan pada {partitions} akan dipadam. Tindakan ini tidak boleh dibuat asal."

#: src/pages.cpp
msgid "Installing Cutefish"
msgstr "Memasang Cutefish"

#: src/pages.cpp
msgid "Keep the computer on until the installation is complete."
msgstr "Biarkan komputer hidup sehingga pemasangan selesai."

#: src/pages.cpp
msgid "Preparing the disk…"
msgstr "Menyediakan cakera…"

#: src/pages.cpp
msgid "Copying the system…"
msgstr "Menyalin sistem…"

#: src/pages.cpp
msgid "Setting up your account and settings…"
msgstr "Menyediakan akaun dan tetapan anda…"

#: src/pages.cpp
msgid "Installing the boot loader…"
msgstr "Memasang pemuat but…"

#: src/pages.cpp
msgid "Finishing…"
msgstr "Menyelesaikan…"

#: src/pages.cpp
msgid "Cutefish Is Installed"
msgstr "Cutefish Telah Dipasang"

#: src/pages.cpp
msgid "Restart the computer and remove the installation medium to start using Cutefish."
msgstr "Mulakan semula komputer dan keluarkan media pemasangan untuk mula menggunakan Cutefish."

#: src/pages.cpp
msgid "The Installation Failed"
msgstr "Pemasangan Gagal"

#: src/pages.cpp
#, python-brace-format
msgid "Cutefish could not be installed. The details are in {path}."
msgstr "Cutefish tidak dapat dipasang. Butirannya ada dalam {path}."

#. TRANSLATORS: What a partition is used for: nothing.
#: src/partitionpage.cpp
msgid "Not used"
msgstr "Tidak digunakan"

#. TRANSLATORS: What a partition is used for; {mount} is "/".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (system)"
msgstr "{mount} (sistem)"

#. TRANSLATORS: What a partition is used for; {mount} is "/boot/efi".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (EFI system)"
msgstr "{mount} (sistem EFI)"

#. TRANSLATORS: What a partition is used for: swap space.
#: src/partitionpage.cpp
msgid "Swap"
msgstr "Swap"

#. TRANSLATORS: What a partition is used for: the boot loader on a computer without UEFI.
#: src/partitionpage.cpp
msgid "BIOS boot"
msgstr "But BIOS"

#. TRANSLATORS: Marks a partition that exists and will be formatted.
#: src/partitionpage.cpp
msgid "Format"
msgstr "Format"

#: src/partitionpage.cpp
msgid "Free space"
msgstr "Ruang kosong"

#: src/partitionpage.cpp
msgid "New partition"
msgstr "Partisyen baharu"

#: src/partitionpage.cpp
msgid "Size"
msgstr "Saiz"

#: src/partitionpage.cpp
msgid "Use as"
msgstr "Guna sebagai"

#: src/partitionpage.cpp
msgid "File system"
msgstr "Sistem fail"

#: src/partitionpage.cpp
msgid "Format this partition"
msgstr "Formatkan partisyen ini"

#: src/partitionpage.cpp
msgid "Cancel"
msgstr "Batal"

#: src/partitionpage.cpp
msgid "Add"
msgstr "Tambah"

#: src/partitionpage.cpp
msgid "Save"
msgstr "Simpan"

#: src/partitionpage.cpp
msgid "Partition the Disk"
msgstr "Partisyen Cakera"

#: src/partitionpage.cpp
msgid "New Partition Table"
msgstr "Jadual Partisyen Baharu"

#: src/partitionpage.cpp
msgid "Add…"
msgstr "Tambah…"

#: src/partitionpage.cpp
msgid "Edit…"
msgstr "Edit…"

#: src/partitionpage.cpp
msgid "Delete"
msgstr "Padam"

#. TRANSLATORS: "Partition" is the header of the column of partition names.
#: src/partitionpage.cpp
msgid "Partition"
msgstr "Partisyen"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Nothing changes on {disk} until you install."
msgstr "Tiada apa-apa berubah pada {disk} sehingga anda memasang."

#: src/partitionpage.cpp
#, python-brace-format
msgid "The partitions cannot be read: {error}"
msgstr "Partisyen tidak dapat dibaca: {error}"

#: src/partitionpage.cpp
msgid "Create a new partition table?"
msgstr "Cipta jadual partisyen baharu?"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted when Cutefish is installed."
msgstr "Setiap partisyen pada {disk} akan dipadam apabila Cutefish dipasang."

#: src/partitionpage.cpp
msgid "Add Partition"
msgstr "Tambah Partisyen"

#: src/partitionpage.cpp
msgid "New Partition"
msgstr "Partisyen Baharu"

#: data/cutefish-installer.desktop
msgid "Install Cutefish on this computer"
msgstr "Pasang Cutefish pada komputer ini"

#: data/cutefish-installer.desktop
msgid "Installer;Install;Setup;Disk;"
msgstr "Pemasang;Pasang;Persediaan;Cakera;Installer;Install;"
