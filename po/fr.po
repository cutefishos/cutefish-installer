#: common/partitioning.cpp
msgid "The disk has no partition table. Create one first."
msgstr "Le disque n'a pas de table de partitions. Créez-en une d'abord."

#: common/partitioning.cpp
msgid "A disk with an MBR partition table holds at most four partitions."
msgstr "Un disque doté d'une table de partitions MBR contient au plus quatre partitions."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{mount}” is not a mount point the system can use."
msgstr "« {mount} » n'est pas un point de montage utilisable par le système."

#: common/partitioning.cpp
#, python-brace-format
msgid "Two partitions are given “{mount}”."
msgstr "Deux partitions ont le même point de montage « {mount} »."

#: common/partitioning.cpp
msgid "Only a disk with a GPT partition table needs a BIOS boot partition."
msgstr "Seul un disque doté d'une table de partitions GPT a besoin d'une partition d'amorçage BIOS."

#: common/partitioning.cpp
msgid "Only a new partition, or one made for it, can be the BIOS boot partition."
msgstr "Seule une nouvelle partition, ou une partition créée à cet effet, peut servir de partition d'amorçage BIOS."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” must be formatted."
msgstr "La partition pour « {mount} » doit être formatée."

#: common/partitioning.cpp
#, python-brace-format
msgid "“{type}” cannot be used for “{mount}”."
msgstr "« {type} » ne peut pas être utilisé pour « {mount} »."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds no file system; format it to use it there."
msgstr "La partition pour « {mount} » ne contient aucun système de fichiers ; formatez-la pour l'utiliser à cet emplacement."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds “{type}”; format it to use it there."
msgstr "La partition pour « {mount} » contient « {type} » ; formatez-la pour l'utiliser à cet emplacement."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose a partition for the system: give one the mount point “{mount}”."
msgstr "Choisissez une partition pour le système : attribuez à l'une d'elles le point de montage « {mount} »."

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” needs at least {size} GB."
msgstr "La partition pour « {mount} » doit faire au moins {size} GB."

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose an EFI system partition: give one the mount point “{mount}”."
msgstr "Choisissez une partition système EFI : attribuez à l'une d'elles le point de montage « {mount} »."

#: common/partitioning.cpp
msgid "The EFI system partition needs at least 32 MB."
msgstr "La partition système EFI doit faire au moins 32 MB."

#: common/partitioning.cpp
msgid "Add a 1 MB partition used as BIOS boot, for the boot loader."
msgstr "Ajoutez une partition de 1 MB utilisée comme amorçage BIOS, pour le chargeur d'amorçage."

#: src/backend.cpp
msgid "The installer service stopped unexpectedly."
msgstr "Le service d'installation s'est arrêté de manière inattendue."

#: src/backend.cpp
msgid "The system bus cannot be reached."
msgstr "Le bus système est injoignable."

#: src/backend.cpp
msgid "The disks cannot be listed."
msgstr "Impossible de lister les disques."

#: src/backend.cpp
msgid "The file systems cannot be listed."
msgstr "Impossible de lister les systèmes de fichiers."

#: src/backend.cpp
msgid "The partitions cannot be read."
msgstr "Impossible de lire les partitions."

#: src/installerwindow.cpp data/cutefish-installer.desktop
#: data/cutefish-installer-autostart.desktop
msgid "Install Cutefish"
msgstr "Installer Cutefish"

#: src/installerwindow.cpp
msgid "Back"
msgstr "Retour"

#: src/installerwindow.cpp
msgid "Continue"
msgstr "Continuer"

#: src/installerwindow.cpp
msgid "Try Cutefish"
msgstr "Essayer Cutefish"

#: src/installerwindow.cpp
msgid "Next"
msgstr "Suivant"

#: src/installerwindow.cpp
msgid "Install"
msgstr "Installer"

#: src/installerwindow.cpp
msgid "Erase Disk and Install"
msgstr "Effacer le disque et installer"

#. TRANSLATORS: After a successful installation: go on using the live system instead of restarting.
#: src/installerwindow.cpp
msgid "Keep Trying"
msgstr "Continuer l'essai"

#: src/installerwindow.cpp
msgid "Close"
msgstr "Fermer"

#: src/installerwindow.cpp
msgid "Restart Now"
msgstr "Redémarrer maintenant"

#: src/installerwindow.cpp
msgid "Try Again"
msgstr "Réessayer"

#: src/pages.cpp
msgid "Choose Your Language"
msgstr "Choisissez votre langue"

#: src/pages.cpp
msgid "The installer and the installed system use this language."
msgstr "Le programme d'installation et le système installé utilisent cette langue."

#: src/pages.cpp
msgid "Welcome to Cutefish"
msgstr "Bienvenue dans Cutefish"

#: src/pages.cpp
msgid "Try Cutefish without changing your computer, or install it now."
msgstr "Essayez Cutefish sans modifier votre ordinateur, ou installez-le dès maintenant."

#: src/pages.cpp
msgid "Choose a Disk"
msgstr "Choisissez un disque"

#: src/pages.cpp
msgid "Cutefish uses the whole disk. Everything on it will be erased."
msgstr "Cutefish utilise le disque entier. Tout son contenu sera effacé."

#: src/pages.cpp
msgid "Partition manually"
msgstr "Partitionner manuellement"

#: src/pages.cpp
msgid "Choose the partitions on the next page."
msgstr "Choisissez les partitions à la page suivante."

#. TRANSLATORS: Beside a disk; {size} is a size such as "12.0 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Too small, needs {size}"
msgstr "Trop petit, {size} requis"

#: src/pages.cpp
msgid "No disk was found to install on."
msgstr "Aucun disque sur lequel installer n'a été trouvé."

#: src/pages.cpp
#, python-brace-format
msgid "The disks cannot be listed: {error}"
msgstr "Impossible de lister les disques : {error}"

#: src/pages.cpp
msgid "Create Your Account"
msgstr "Créez votre compte"

#: src/pages.cpp
msgid "This account can change settings and install software."
msgstr "Ce compte peut modifier les réglages et installer des logiciels."

#: src/pages.cpp
msgid "Full name"
msgstr "Nom complet"

#: src/pages.cpp
msgid "User name"
msgstr "Nom d'utilisateur"

#: src/pages.cpp
msgid "Computer name"
msgstr "Nom de l'ordinateur"

#: src/pages.cpp
msgid "Password"
msgstr "Mot de passe"

#: src/pages.cpp
msgid "Confirm password"
msgstr "Confirmer le mot de passe"

#. TRANSLATORS: In an empty field that must be filled in.
#: src/pages.cpp
msgid "Required"
msgstr "Obligatoire"

#: src/pages.cpp
msgid "A user name starts with a lower-case letter and uses only a–z, 0–9, “-” and “_”."
msgstr "Un nom d'utilisateur commence par une lettre minuscule et ne contient que a–z, 0–9, « - » et « _ »."

#: src/pages.cpp
#, python-brace-format
msgid "“{name}” is taken by the system. Choose another user name."
msgstr "« {name} » est réservé par le système. Choisissez un autre nom d'utilisateur."

#: src/pages.cpp
msgid "A computer name uses only letters, digits and hyphens, and does not start or end with a hyphen."
msgstr "Un nom d'ordinateur ne contient que des lettres, des chiffres et des traits d'union, et ne commence ni ne se termine par un trait d'union."

#: src/pages.cpp
msgid "The passwords do not match."
msgstr "Les mots de passe ne correspondent pas."

#: src/pages.cpp
msgid "Choose Your Time Zone"
msgstr "Choisissez votre fuseau horaire"

#: src/pages.cpp
msgid "The clock follows the time zone. You can change it later in Settings."
msgstr "L'horloge suit le fuseau horaire. Vous pourrez le modifier plus tard dans Paramètres."

#: src/pages.cpp
msgid "Search for a city or country"
msgstr "Rechercher une ville ou un pays"

#: src/pages.cpp
msgid "Ready to Install"
msgstr "Prêt à installer"

#: src/pages.cpp
msgid "Check your choices. Go back to change any of them."
msgstr "Vérifiez vos choix. Revenez en arrière pour modifier l'un d'eux."

#: src/pages.cpp
msgid "Disk"
msgstr "Disque"

#: src/pages.cpp
msgid "Time zone"
msgstr "Fuseau horaire"

#. TRANSLATORS: {disk} is a disk's name and size, such as "Samsung SSD (512.1 GB)".
#: src/pages.cpp
#, python-brace-format
msgid "Partitioned manually, {disk}"
msgstr "Partitionné manuellement, {disk}"

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {disk} will be erased. This cannot be undone."
msgstr "Tout le contenu de {disk} sera effacé. Cette action est irréversible."

#: src/pages.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted. This cannot be undone."
msgstr "Toutes les partitions de {disk} seront supprimées. Cette action est irréversible."

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {partitions} will be erased. This cannot be undone."
msgstr "Tout le contenu de {partitions} sera effacé. Cette action est irréversible."

#: src/pages.cpp
msgid "No existing partition is erased."
msgstr "Aucune partition existante n'est effacée."

#: src/pages.cpp
msgid "Installing Cutefish"
msgstr "Installation de Cutefish"

#: src/pages.cpp
msgid "Keep the computer on until the installation is complete."
msgstr "Laissez l'ordinateur allumé jusqu'à la fin de l'installation."

#: src/pages.cpp
msgid "Preparing the disk…"
msgstr "Préparation du disque…"

#: src/pages.cpp
msgid "Copying the system…"
msgstr "Copie du système…"

#: src/pages.cpp
msgid "Setting up your account and settings…"
msgstr "Configuration de votre compte et de vos réglages…"

#: src/pages.cpp
msgid "Installing the boot loader…"
msgstr "Installation du chargeur d'amorçage…"

#: src/pages.cpp
msgid "Finishing…"
msgstr "Finalisation…"

#: src/pages.cpp
msgid "Cutefish Is Installed"
msgstr "Cutefish est installé"

#: src/pages.cpp
msgid "Restart the computer and remove the installation medium to start using Cutefish."
msgstr "Redémarrez l'ordinateur et retirez le support d'installation pour commencer à utiliser Cutefish."

#: src/pages.cpp
msgid "The Installation Failed"
msgstr "L'installation a échoué"

#: src/pages.cpp
#, python-brace-format
msgid "Cutefish could not be installed. The details are in {path}."
msgstr "Impossible d'installer Cutefish. Les détails se trouvent dans {path}."

#. TRANSLATORS: What a partition is used for: nothing.
#: src/partitionpage.cpp
msgid "Not used"
msgstr "Non utilisée"

#. TRANSLATORS: What a partition is used for; {mount} is "/".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (system)"
msgstr "{mount} (système)"

#. TRANSLATORS: What a partition is used for; {mount} is "/boot/efi".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (EFI system)"
msgstr "{mount} (système EFI)"

#. TRANSLATORS: What a partition is used for: swap space.
#: src/partitionpage.cpp
msgid "Swap"
msgstr "Espace d'échange"

#. TRANSLATORS: What a partition is used for: the boot loader on a computer without UEFI.
#: src/partitionpage.cpp
msgid "BIOS boot"
msgstr "Amorçage BIOS"

#. TRANSLATORS: Marks a partition that exists and will be formatted.
#: src/partitionpage.cpp
msgid "Format"
msgstr "À formater"

#: src/partitionpage.cpp
msgid "Free space"
msgstr "Espace libre"

#: src/partitionpage.cpp
msgid "New partition"
msgstr "Nouvelle partition"

#: src/partitionpage.cpp
msgid "Size"
msgstr "Taille"

#: src/partitionpage.cpp
msgid "Use as"
msgstr "Utiliser comme"

#: src/partitionpage.cpp
msgid "File system"
msgstr "Système de fichiers"

#: src/partitionpage.cpp
msgid "Format this partition"
msgstr "Formater cette partition"

#: src/partitionpage.cpp
msgid "Cancel"
msgstr "Annuler"

#: src/partitionpage.cpp
msgid "Add"
msgstr "Ajouter"

#: src/partitionpage.cpp
msgid "Save"
msgstr "Enregistrer"

#: src/partitionpage.cpp
msgid "Partition the Disk"
msgstr "Partitionnez le disque"

#: src/partitionpage.cpp
msgid "New Partition Table"
msgstr "Nouvelle table de partitions"

#: src/partitionpage.cpp
msgid "Add…"
msgstr "Ajouter…"

#: src/partitionpage.cpp
msgid "Edit…"
msgstr "Modifier…"

#: src/partitionpage.cpp
msgid "Delete"
msgstr "Supprimer"

#. TRANSLATORS: "Partition" is the header of the column of partition names.
#: src/partitionpage.cpp
msgid "Partition"
msgstr "Partition"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Nothing changes on {disk} until you install."
msgstr "Rien ne change sur {disk} avant l'installation."

#: src/partitionpage.cpp
#, python-brace-format
msgid "The partitions cannot be read: {error}"
msgstr "Impossible de lire les partitions : {error}"

#: src/partitionpage.cpp
msgid "Create a new partition table?"
msgstr "Créer une nouvelle table de partitions ?"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted when Cutefish is installed."
msgstr "Toutes les partitions de {disk} seront supprimées lors de l'installation de Cutefish."

#: src/partitionpage.cpp
msgid "Add Partition"
msgstr "Ajouter une partition"

#: src/partitionpage.cpp
msgid "New Partition"
msgstr "Nouvelle partition"

#: data/cutefish-installer.desktop
msgid "Install Cutefish on this computer"
msgstr "Installer Cutefish sur cet ordinateur"

#: data/cutefish-installer.desktop
msgid "Installer;Install;Setup;Disk;"
msgstr "Installateur;Installer;Installation;Configuration;Disque;Setup;"
