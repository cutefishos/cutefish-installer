#: common/partitioning.cpp
msgid "The disk has no partition table. Create one first."
msgstr "ディスクにパーティションテーブルがありません。先に作成してください。"

#: common/partitioning.cpp
msgid "A disk with an MBR partition table holds at most four partitions."
msgstr "MBR パーティションテーブルのディスクに作成できるパーティションは 4 つまでです。"

#: common/partitioning.cpp
#, python-brace-format
msgid "“{mount}” is not a mount point the system can use."
msgstr "「{mount}」はシステムで使用できるマウントポイントではありません。"

#: common/partitioning.cpp
#, python-brace-format
msgid "Two partitions are given “{mount}”."
msgstr "2 つのパーティションに「{mount}」が指定されています。"

#: common/partitioning.cpp
msgid "Only a disk with a GPT partition table needs a BIOS boot partition."
msgstr "BIOS ブートパーティションが必要なのは、GPT パーティションテーブルのディスクだけです。"

#: common/partitioning.cpp
msgid "Only a new partition, or one made for it, can be the BIOS boot partition."
msgstr "BIOS ブートパーティションにできるのは、新規パーティションか、そのために作成されたパーティションだけです。"

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” must be formatted."
msgstr "「{mount}」のパーティションはフォーマットする必要があります。"

#: common/partitioning.cpp
#, python-brace-format
msgid "“{type}” cannot be used for “{mount}”."
msgstr "「{type}」は「{mount}」には使用できません。"

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds no file system; format it to use it there."
msgstr "「{mount}」のパーティションにはファイルシステムがありません。そこで使用するにはフォーマットしてください。"

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” holds “{type}”; format it to use it there."
msgstr "「{mount}」のパーティションは「{type}」です。そこで使用するにはフォーマットしてください。"

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose a partition for the system: give one the mount point “{mount}”."
msgstr "システム用のパーティションを選択してください: いずれかにマウントポイント「{mount}」を指定します。"

#: common/partitioning.cpp
#, python-brace-format
msgid "The partition for “{mount}” needs at least {size} GB."
msgstr "「{mount}」のパーティションには {size} GB 以上が必要です。"

#: common/partitioning.cpp
#, python-brace-format
msgid "Choose an EFI system partition: give one the mount point “{mount}”."
msgstr "EFI システムパーティションを選択してください: いずれかにマウントポイント「{mount}」を指定します。"

#: common/partitioning.cpp
msgid "The EFI system partition needs at least 32 MB."
msgstr "EFI システムパーティションには 32 MB 以上が必要です。"

#: common/partitioning.cpp
msgid "Add a 1 MB partition used as BIOS boot, for the boot loader."
msgstr "ブートローダ用に、BIOS ブートとして使用する 1 MB のパーティションを追加してください。"

#: src/backend.cpp
msgid "The installer service stopped unexpectedly."
msgstr "インストーラサービスが予期せず停止しました。"

#: src/backend.cpp
msgid "The system bus cannot be reached."
msgstr "システムバスに接続できません。"

#: src/backend.cpp
msgid "The disks cannot be listed."
msgstr "ディスクの一覧を取得できません。"

#: src/backend.cpp
msgid "The file systems cannot be listed."
msgstr "ファイルシステムの一覧を取得できません。"

#: src/backend.cpp
msgid "The partitions cannot be read."
msgstr "パーティションを読み込めません。"

#: src/installerwindow.cpp data/cutefish-installer.desktop
#: data/cutefish-installer-autostart.desktop
msgid "Install Cutefish"
msgstr "Cutefish をインストール"

#: src/installerwindow.cpp
msgid "Back"
msgstr "戻る"

#: src/installerwindow.cpp
msgid "Continue"
msgstr "続ける"

#: src/installerwindow.cpp
msgid "Try Cutefish"
msgstr "Cutefish を試す"

#: src/installerwindow.cpp
msgid "Next"
msgstr "次へ"

#: src/installerwindow.cpp
msgid "Install"
msgstr "インストール"

#: src/installerwindow.cpp
msgid "Erase Disk and Install"
msgstr "ディスクを消去してインストール"

#. TRANSLATORS: After a successful installation: go on using the live system instead of restarting.
#: src/installerwindow.cpp
msgid "Keep Trying"
msgstr "試用を続ける"

#: src/installerwindow.cpp
msgid "Close"
msgstr "閉じる"

#: src/installerwindow.cpp
msgid "Restart Now"
msgstr "今すぐ再起動"

#: src/installerwindow.cpp
msgid "Try Again"
msgstr "もう一度試す"

#: src/pages.cpp
msgid "Choose Your Language"
msgstr "言語を選択"

#: src/pages.cpp
msgid "The installer and the installed system use this language."
msgstr "インストーラとインストールされるシステムで、この言語を使用します。"

#: src/pages.cpp
msgid "Welcome to Cutefish"
msgstr "Cutefish へようこそ"

#: src/pages.cpp
msgid "Try Cutefish without changing your computer, or install it now."
msgstr "コンピュータを変更せずに Cutefish を試すか、今すぐインストールできます。"

#: src/pages.cpp
msgid "Choose a Disk"
msgstr "ディスクを選択"

#: src/pages.cpp
msgid "Cutefish uses the whole disk. Everything on it will be erased."
msgstr "Cutefish はディスク全体を使用します。ディスク上のすべてのデータが消去されます。"

#: src/pages.cpp
msgid "Partition manually"
msgstr "手動でパーティションを設定"

#: src/pages.cpp
msgid "Choose the partitions on the next page."
msgstr "次のページでパーティションを選択します。"

#. TRANSLATORS: Beside a disk; {size} is a size such as "12.0 GB".
#: src/pages.cpp
#, python-brace-format
msgid "Too small, needs {size}"
msgstr "容量不足（{size} 必要）"

#: src/pages.cpp
msgid "No disk was found to install on."
msgstr "インストール先のディスクが見つかりません。"

#: src/pages.cpp
#, python-brace-format
msgid "The disks cannot be listed: {error}"
msgstr "ディスクの一覧を取得できません: {error}"

#: src/pages.cpp
msgid "Create Your Account"
msgstr "アカウントを作成"

#: src/pages.cpp
msgid "This account can change settings and install software."
msgstr "このアカウントでは、設定の変更やソフトウェアのインストールができます。"

#: src/pages.cpp
msgid "Full name"
msgstr "フルネーム"

#: src/pages.cpp
msgid "User name"
msgstr "ユーザ名"

#: src/pages.cpp
msgid "Computer name"
msgstr "コンピュータ名"

#: src/pages.cpp
msgid "Password"
msgstr "パスワード"

#: src/pages.cpp
msgid "Confirm password"
msgstr "パスワードの確認"

#. TRANSLATORS: In an empty field that must be filled in.
#: src/pages.cpp
msgid "Required"
msgstr "必須"

#: src/pages.cpp
msgid "A user name starts with a lower-case letter and uses only a–z, 0–9, “-” and “_”."
msgstr "ユーザ名は小文字の英字で始め、a～z、0～9、「-」、「_」だけを使用してください。"

#: src/pages.cpp
#, python-brace-format
msgid "“{name}” is taken by the system. Choose another user name."
msgstr "「{name}」はシステムで使用されています。別のユーザ名を選択してください。"

#: src/pages.cpp
msgid "A computer name uses only letters, digits and hyphens, and does not start or end with a hyphen."
msgstr "コンピュータ名には英字、数字、ハイフンだけを使用でき、先頭と末尾にはハイフンを使用できません。"

#: src/pages.cpp
msgid "The passwords do not match."
msgstr "パスワードが一致しません。"

#: src/pages.cpp
msgid "Choose Your Time Zone"
msgstr "時間帯を選択"

#: src/pages.cpp
msgid "The clock follows the time zone. You can change it later in Settings."
msgstr "時計は時間帯に従います。時間帯はあとで「設定」で変更できます。"

#: src/pages.cpp
msgid "Search for a city or country"
msgstr "都市または国を検索"

#: src/pages.cpp
msgid "Ready to Install"
msgstr "インストールの準備ができました"

#: src/pages.cpp
msgid "Check your choices. Go back to change any of them."
msgstr "選択内容を確認してください。変更するには前のページに戻ってください。"

#: src/pages.cpp
msgid "Disk"
msgstr "ディスク"

#: src/pages.cpp
msgid "Time zone"
msgstr "時間帯"

#. TRANSLATORS: {disk} is a disk's name and size, such as "Samsung SSD (512.1 GB)".
#: src/pages.cpp
#, python-brace-format
msgid "Partitioned manually, {disk}"
msgstr "手動でパーティションを設定、{disk}"

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {disk} will be erased. This cannot be undone."
msgstr "{disk} 上のすべてのデータが消去されます。この操作は取り消せません。"

#: src/pages.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted. This cannot be undone."
msgstr "{disk} 上のすべてのパーティションが削除されます。この操作は取り消せません。"

#: src/pages.cpp
#, python-brace-format
msgid "Everything on {partitions} will be erased. This cannot be undone."
msgstr "{partitions} 上のすべてのデータが消去されます。この操作は取り消せません。"

#: src/pages.cpp
msgid "No existing partition is erased."
msgstr "既存のパーティションは消去されません。"

#: src/pages.cpp
msgid "Installing Cutefish"
msgstr "Cutefish をインストール中"

#: src/pages.cpp
msgid "Keep the computer on until the installation is complete."
msgstr "インストールが完了するまで、コンピュータの電源を切らないでください。"

#: src/pages.cpp
msgid "Preparing the disk…"
msgstr "ディスクを準備中…"

#: src/pages.cpp
msgid "Copying the system…"
msgstr "システムをコピー中…"

#: src/pages.cpp
msgid "Setting up your account and settings…"
msgstr "アカウントと設定を構成中…"

#: src/pages.cpp
msgid "Installing the boot loader…"
msgstr "ブートローダをインストール中…"

#: src/pages.cpp
msgid "Finishing…"
msgstr "終了処理中…"

#: src/pages.cpp
msgid "Cutefish Is Installed"
msgstr "Cutefish がインストールされました"

#: src/pages.cpp
msgid "Restart the computer and remove the installation medium to start using Cutefish."
msgstr "Cutefish を使い始めるには、コンピュータを再起動して、インストールメディアを取り外してください。"

#: src/pages.cpp
msgid "The Installation Failed"
msgstr "インストールに失敗しました"

#: src/pages.cpp
#, python-brace-format
msgid "Cutefish could not be installed. The details are in {path}."
msgstr "Cutefish をインストールできませんでした。詳細は {path} にあります。"

#. TRANSLATORS: What a partition is used for: nothing.
#: src/partitionpage.cpp
msgid "Not used"
msgstr "使用しない"

#. TRANSLATORS: What a partition is used for; {mount} is "/".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (system)"
msgstr "{mount}（システム）"

#. TRANSLATORS: What a partition is used for; {mount} is "/boot/efi".
#: src/partitionpage.cpp
#, python-brace-format
msgid "{mount} (EFI system)"
msgstr "{mount}（EFI システム）"

#. TRANSLATORS: What a partition is used for: swap space.
#: src/partitionpage.cpp
msgid "Swap"
msgstr "スワップ"

#. TRANSLATORS: What a partition is used for: the boot loader on a computer without UEFI.
#: src/partitionpage.cpp
msgid "BIOS boot"
msgstr "BIOS ブート"

#. TRANSLATORS: Marks a partition that exists and will be formatted.
#: src/partitionpage.cpp
msgid "Format"
msgstr "フォーマット"

#: src/partitionpage.cpp
msgid "Free space"
msgstr "空き領域"

#: src/partitionpage.cpp
msgid "New partition"
msgstr "新規パーティション"

#: src/partitionpage.cpp
msgid "Size"
msgstr "サイズ"

#: src/partitionpage.cpp
msgid "Use as"
msgstr "用途"

#: src/partitionpage.cpp
msgid "File system"
msgstr "ファイルシステム"

#: src/partitionpage.cpp
msgid "Format this partition"
msgstr "このパーティションをフォーマット"

#: src/partitionpage.cpp
msgid "Cancel"
msgstr "キャンセル"

#: src/partitionpage.cpp
msgid "Add"
msgstr "追加"

#: src/partitionpage.cpp
msgid "Save"
msgstr "保存"

#: src/partitionpage.cpp
msgid "Partition the Disk"
msgstr "ディスクのパーティション設定"

#: src/partitionpage.cpp
msgid "New Partition Table"
msgstr "新規パーティションテーブル"

#: src/partitionpage.cpp
msgid "Add…"
msgstr "追加…"

#: src/partitionpage.cpp
msgid "Edit…"
msgstr "編集…"

#: src/partitionpage.cpp
msgid "Delete"
msgstr "削除"

#. TRANSLATORS: "Partition" is the header of the column of partition names.
#: src/partitionpage.cpp
msgid "Partition"
msgstr "パーティション"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Nothing changes on {disk} until you install."
msgstr "インストールするまで、{disk} には何も変更が加えられません。"

#: src/partitionpage.cpp
#, python-brace-format
msgid "The partitions cannot be read: {error}"
msgstr "パーティションを読み込めません: {error}"

#: src/partitionpage.cpp
msgid "Create a new partition table?"
msgstr "新しいパーティションテーブルを作成しますか?"

#: src/partitionpage.cpp
#, python-brace-format
msgid "Every partition on {disk} will be deleted when Cutefish is installed."
msgstr "Cutefish のインストール時に、{disk} 上のすべてのパーティションが削除されます。"

#: src/partitionpage.cpp
msgid "Add Partition"
msgstr "パーティションを追加"

#: src/partitionpage.cpp
msgid "New Partition"
msgstr "新規パーティション"

#: data/cutefish-installer.desktop
msgid "Install Cutefish on this computer"
msgstr "このコンピュータに Cutefish をインストールします"

#: data/cutefish-installer.desktop
msgid "Installer;Install;Setup;Disk;"
msgstr "Installer;Install;Setup;Disk;インストーラ;インストール;セットアップ;ディスク;"
